{
  "name": "csm-pi-session-monitor",
  "version": "0.1.1",
  "description": "Report pi session activity to Claude Session Monitor",
  "type": "module",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/simonrw/claude-session-monitor.git",
    "directory": "contrib/pi"
  },
  "keywords": ["pi-package", "session-monitor"],
